<%- include("partials/head") %>
<%- include("partials/navbar") %>

<section class="sayfa-baslik">
    <div class="container">
        <nav class="breadcrumb">
            <a href="/">Ana Sayfa</a>&nbsp;›&nbsp;Bölümler
        </nav>
        <h2 class="mb-0">Bölümler</h2>
    </div>
</section>

<main class="container py-5">
    <div class="row g-3">
        <% bolumler.forEach(bolum => { %>
            <div class="col-md-6 col-lg-4">
                <div class="sinaps-kart h-100">
                    <i class="bi bi-mortarboard fs-3" style="color: var(--mavi);"></i>
                    <h6 class="mt-2 mb-1"><a href="/bolum/<%= bolum.slug %>"><%= bolum.ad %></a></h6>
                    <span class="soluk"><%= bolum.dersSayisi %> ders · <%= bolum.notSayisi %> not</span>
                </div>
            </div>
        <% }) %>
    </div>
</main>

<%- include("partials/footer") %>