<%- include("../partials/head") %>
<%- include("../partials/navbar") %>

<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="sinaps-kart p-4">
                <h3 class="mb-1">Aramıza katıl</h3>
                <p class="soluk mb-4">Notlarını paylaş, puan kazan.</p>

                <% if (hata) { %>
                    <div class="alert alert-danger py-2"><%= hata %></div>
                <% } %>

                <form action="/kayit" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="mb-3">
                        <label class="form-label">Kullanıcı adı</label>
                        <input type="text" name="ad" class="form-control" value="<%= eski.ad || '' %>" maxlength="30" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Öğrenci e-postası</label>
                        <input type="email" name="email" class="form-control"
                               placeholder="ogrenci@<%= okulAlanAdi %>"
                               value="<%= eski.email || '' %>" required>
                        <div class="form-text">Sadece @<%= okulAlanAdi %> uzantılı adresler kabul edilir.</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-7">
                            <label class="form-label">Bölüm</label>
                            <select name="bolum" class="form-select" required>
                                <option value="">Bölümünü seç</option>
                                <% bolumler.forEach(b => { %>
                                    <option value="<%= b.id %>" <%= eski.bolumId === b.id ? "selected" : "" %>><%= b.ad %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-sm-5">
                            <label class="form-label">Sınıf</label>
                            <select name="sinif" class="form-select" required>
                                <option value="">Seç</option>
                                <% siniflar.forEach(s => { %>
                                    <option value="<%= s.deger %>" <%= eski.sinif === s.deger ? "selected" : "" %>><%= s.ad %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Şifre</label>
                        <input type="password" name="sifre" class="form-control" minlength="6" required>
                        <div class="form-text">En az 6 karakter</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Şifre tekrar</label>
                        <input type="password" name="sifreTekrar" class="form-control" required>
                    </div>

                    <button type="submit" class="btn btn-turuncu w-100">Kayıt ol</button>
                </form>

                <p class="soluk text-center mt-3 mb-0">
                    Zaten üye misin? <a href="/giris">Giriş yap</a>
                </p>
            </div>
        </div>
    </div>
</main>

<%- include("../partials/footer") %>