<%- include("../partials/head") %>
<%- include("../partials/navbar") %>

<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="sinaps-kart p-4">
                <h3 class="mb-1">Aramıza katıl</h3>
                <p class="soluk mb-4">Notlarını paylaş, puan kazan.</p>

                <% if (hata) { %>
                    <div class="alert alert-danger py-2"><%= hata %></div>
                <% } %>

                <form action="/kayit" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Kullanıcı adı</label>
                        <input type="text" name="ad" class="form-control" value="<%= eski.ad || '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">E-posta</label>
                        <input type="email" name="email" class="form-control" value="<%= eski.email || '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Şifre</label>
                        <input type="password" name="sifre" class="form-control" minlength="6" required>
                        <div class="form-text">En az 6 karakter</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Şifre tekrar</label>
                        <input type="password" name="sifreTekrar" class="form-control" required>
                    </div>
                    <button type="submit" class="btn btn-turuncu w-100">Kayıt ol</button>
                </form>

                <p class="soluk text-center mt-3 mb-0">
                    Zaten üye misin? <a href="/giris">Giriş yap</a>
                </p>
            </div>
        </div>
    </div>
</main>

<%- include("../partials/footer") %>