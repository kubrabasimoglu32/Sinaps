<%- include("partials/head") %>
<%- include("partials/navbar") %>

<section class="sayfa-baslik">
    <div class="container">
        <nav class="breadcrumb"><a href="/">Ana Sayfa</a>&nbsp;›&nbsp;Soru-Cevap</nav>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h2 class="mb-0">Soru-Cevap</h2>
            <a href="/soru-sor" class="btn btn-turuncu"><i class="bi bi-question-circle"></i> Soru sor</a>
        </div>
    </div>
</section>

<main class="container py-5">
    <% if (sorular.length === 0) { %>
        <div class="bos-durum"><p class="soluk mb-0">Henüz soru sorulmamış. İlk soruyu sen sor!</p></div>
    <% } else { %>
        <% sorular.forEach(soru => { %>
            <div class="sinaps-kart mb-3 d-flex justify-content-between align-items-center gap-3">
                <div>
                    <div class="ders-etiketi"><%= soru.ders.ad %></div>
                    <h6 class="mb-1"><a href="/soru/<%= soru.slug %>"><%= soru.baslik %></a></h6>
                    <span class="soluk"><%= soru.soran %> · <%= soru.tarih %></span>
                </div>
                <div class="text-center text-nowrap">
                    <% if (soru.enIyiCevapId) { %>
                        <span class="en-iyi-etiket"><i class="bi bi-check-lg"></i> Çözüldü</span>
                    <% } %>
                    <div class="soluk mt-1"><%= soru.cevapSayisi %> cevap</div>
                </div>
            </div>
        <% }) %>
    <% } %>
</main>

<%- include("partials/footer") %>